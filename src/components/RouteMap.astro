---
interface Props {
  trackPoints: Array<{ lat: number; lng: number }>;
  class?: string;
  id?: string;
}

const { trackPoints, class: className, id } = Astro.props;

// Calculate bounding box for fitting the route
const lats = trackPoints.map((p) => p.lat);
const lngs = trackPoints.map((p) => p.lng);
const bounds = [
  [Math.min(...lats), Math.min(...lngs)],
  [Math.max(...lats), Math.max(...lngs)],
];

const mapId = id || `map-${Math.random().toString(36).slice(2, 9)}`;
const routeCoords = JSON.stringify(trackPoints.map((p) => [p.lat, p.lng]));
const boundsJson = JSON.stringify(bounds);
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div id={mapId} class={className}></div>

<script is:inline define:vars={{ mapId, routeCoords, boundsJson }}>
  (function() {
    const map = L.map(mapId, {
      scrollWheelZoom: false,
      dragging: false,
      zoomControl: false,
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      maxZoom: 19,
    }).addTo(map);

    const route = JSON.parse(routeCoords);
    const bounds = JSON.parse(boundsJson);

    L.polyline(route, {
      color: '#dc2626',
      weight: 4,
      opacity: 0.8,
    }).addTo(map);

    map.fitBounds(bounds, { padding: [20, 20] });
  })();
</script>
