---
import type { RouteData } from '../lib/ridewithgps';
import { formatDistance, formatElevation } from '../lib/routes';
import RouteMap from './RouteMap.astro';

interface Props {
  slug: string;
  routeData: RouteData;
  shortDescription: string;
}

const { slug, routeData, shortDescription } = Astro.props;
---

<a href={`/rides/${slug}`} class="block bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden">
  <div class="aspect-video bg-stone-200 relative">
    <RouteMap trackPoints={routeData.trackPoints} class="w-full h-full" />
  </div>
  <div class="p-4">
    <h2 class="text-lg font-semibold text-stone-900 mb-2">{routeData.name}</h2>
    <div class="flex gap-4 text-sm text-stone-600 mb-3">
      <span>{formatDistance(routeData.distance)}</span>
      <span>{formatElevation(routeData.elevationGain)}</span>
    </div>
    <p class="text-stone-700 text-sm line-clamp-2">{shortDescription}</p>
  </div>
</a>
