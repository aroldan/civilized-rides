---
import type { RouteData } from '../lib/ridewithgps';
import { formatDistance, formatElevation } from '../lib/routes';
import RouteMap from './RouteMap.astro';

interface Props {
  slug: string;
  routeData: RouteData;
  shortDescription: string;
  tags?: string[];
}

const { slug, routeData, shortDescription, tags } = Astro.props;

// Tag display names
const tagLabels: Record<string, string> = {
  'loop': 'Loop',
  'point-to-point': 'Point-to-Point',
  'epic': 'Epic'
};
---

<a href={`/rides/${slug}`} class="flex flex-col md:flex-row bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow overflow-hidden">
  <div class="w-full md:w-64 lg:w-80 aspect-video bg-stone-200 relative flex-shrink-0">
    <RouteMap trackPoints={routeData.trackPoints} class="w-full h-full" />
  </div>
  <div class="p-4 flex-1 flex flex-col">
    <h2 class="text-xl font-semibold text-stone-900 mb-2">{routeData.name}</h2>
    <p class="text-stone-700 text-sm mb-3 line-clamp-2">{shortDescription}</p>
    <div class="flex flex-wrap items-center gap-4 text-sm text-stone-600 mt-auto">
      <span class="font-medium">{formatDistance(routeData.distance)}</span>
      <span class="font-medium">{formatElevation(routeData.elevationGain)}</span>
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="px-2 py-0.5 bg-stone-100 text-stone-700 text-xs rounded-full">
              {tagLabels[tag] || tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
</a>
