---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import RouteMap from '../../components/RouteMap.astro';
import { getRouteData, formatDistance, formatElevation } from '../../lib/routes';

export async function getStaticPaths() {
  const rides = await getCollection('rides');
  return rides.map((ride) => ({
    params: { slug: ride.slug },
    props: { ride },
  }));
}

const { ride } = Astro.props;
const { Content } = await render(ride);
const routeData = await getRouteData(ride.slug);

if (!routeData) {
  return Astro.redirect('/');
}

const stopIcons: Record<string, string> = {
  coffee: '☕',
  beer: '🍺',
  food: '🍴',
  sight: '📍',
  transportation: '🚂'
};

const stops = ride.data.stops ?? [];
---

<Layout title={routeData.name}>
  <div class="max-w-4xl mx-auto">
    <a href="/" class="text-stone-600 hover:text-stone-900 mb-4 inline-block">&larr; Back to rides</a>

    <h1 class="text-3xl font-bold mb-4">{routeData.name}</h1>

    <div class="bg-white rounded-lg shadow-md overflow-hidden mb-8">
      <div class="aspect-video">
        <RouteMap trackPoints={routeData.trackPoints} class="w-full h-full" />
      </div>

      <div class="p-6">
        <div class="flex flex-wrap gap-6 mb-6">
          <div>
            <span class="text-stone-500 text-sm">Distance</span>
            <p class="text-xl font-semibold">{formatDistance(routeData.distance)}</p>
          </div>
          <div>
            <span class="text-stone-500 text-sm">Elevation Gain</span>
            <p class="text-xl font-semibold">{formatElevation(routeData.elevationGain)}</p>
          </div>
          <div>
            <span class="text-stone-500 text-sm">Terrain</span>
            <p class="text-xl font-semibold capitalize">{routeData.terrain}</p>
          </div>
          <div>
            <span class="text-stone-500 text-sm">Difficulty</span>
            <p class="text-xl font-semibold capitalize">{routeData.difficulty}</p>
          </div>
        </div>

        <a
          href={ride.data.ridewithgps_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-stone-800 text-white px-4 py-2 rounded hover:bg-stone-700 transition-colors"
        >
          View on RideWithGPS &rarr;
        </a>
      </div>
    </div>

    <div class="prose prose-stone max-w-none mb-8">
      <Content />
    </div>

    {stops.length > 0 && (
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-bold mb-4">Suggested Stops</h2>
        <ul class="space-y-3">
          {stops.map((stop) => (
            <li class="flex items-center gap-3">
              <span class="text-2xl" title={stop.type}>{stopIcons[stop.type]}</span>
              <div>
                {stop.url ? (
                  <a
                    href={stop.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-stone-900 hover:text-red-700 underline"
                  >{stop.name}</a>
                ) : (
                  <span class="font-medium text-stone-900">{stop.name}</span>
                )}<span class="text-stone-500 ml-1">in {stop.location}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</Layout>
