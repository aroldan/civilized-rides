---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import RideCard from '../components/RideCard.astro';
import { getRouteData } from '../lib/routes';

const RIDES_PER_PAGE = 8;

// Get all rides
const allRides = await getCollection('rides');

// Load route data for each ride
const ridesWithData = await Promise.all(
  allRides.map(async (ride) => {
    const routeData = await getRouteData(ride.slug);
    return { ride, routeData };
  })
);

// Filter out rides without route data
const validRides = ridesWithData.filter((r) => r.routeData !== null);

// For now, just show the first page (pagination can be added later)
const currentPage = 1;
const totalPages = Math.ceil(validRides.length / RIDES_PER_PAGE);
const paginatedRides = validRides.slice(0, RIDES_PER_PAGE);
---

<Layout title="Home">
  <!-- Hero Section -->
  <div class="relative w-screen md:w-full h-64 md:h-80 lg:h-96 mb-16 -ml-4 md:ml-0 left-0 md:left-auto rounded-none md:rounded-lg overflow-hidden">
    <img
      src="/img/hero.jpg"
      alt="A civilized group of road bike riders coming on Lincoln center on a beautiful sumemer morning"
      class="w-full h-full object-cover object-center"
      style="object-position: 50% 24%;"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 to-black/60 flex items-center justify-center">
      <div class="text-center text-white px-4">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4">Civilized Rides</h1>
        <p class="text-lg md:text-xl text-stone-200">Certified delightful bike routes in the Boston area</p>
      </div>
    </div>
  </div>

  <!-- About Section -->
  <div class="max-w-3xl mx-auto mb-12">
    <h2 class="text-2xl font-bold mb-4">What Makes a Ride Civilized?</h2>
    <div class="space-y-4 text-stone-700 leading-relaxed">
      <p>
        It's easy to get stuck in a rut as you start to ride bikes around the Boston area, sticking to the same
        boring bike path routes or out-and-back trafficky routes that you cook up on Google Maps.
      <p>
        Civilized Rides are here to help. These routes are hand-crafted to feature beautiful roads with (mostly) good surface
        and traffic conditions, as well as delightful stops for coffee, snacks, and other delights.
      </p>
      <p>I've personally scouted, ridden, and iterated on every ride here. The routes themselves are
        high-quality, include turn-by-turn directions and POIs, and are regularly updated when I find a flaw or a road change.
        I'm proud of these rides and I hope you have a blast riding them.
      <p>Anthony</p>
    </div>
  </div>

  <!-- Sort and Filter Controls -->
  <div class="mb-8 space-y-4">
    <div class="flex flex-wrap gap-4 items-center justify-between">
      <div class="flex items-center gap-3">
        <label for="sort-select" class="text-sm font-medium text-stone-700">
          Sort by:
        </label>
        <select
          id="sort-select"
          class="px-4 py-2 border border-stone-300 rounded-lg bg-white text-stone-900 focus:outline-none focus:ring-2 focus:ring-stone-400"
        >
          <option value="name">Route Name</option>
          <option value="date">Date Added</option>
          <option value="distance">Distance</option>
          <option value="elevation">Elevation Gain</option>
        </select>
      </div>

      <button
        id="sort-order-btn"
        class="px-4 py-2 border border-stone-300 rounded-lg bg-white hover:bg-stone-50 transition-colors flex items-center gap-2"
        aria-label="Toggle sort order"
      >
        <span id="sort-order-icon">↑</span>
        <span id="sort-order-text">Ascending</span>
      </button>
    </div>

    <!-- Tag Filters -->
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-sm font-medium text-stone-700">Filter by tag:</span>
      <button
        data-tag="all"
        class="tag-filter px-3 py-1 rounded-full text-sm border transition-colors bg-stone-800 text-white border-stone-800"
      >
        All
      </button>
      <button
        data-tag="loop"
        class="tag-filter px-3 py-1 rounded-full text-sm border transition-colors bg-white text-stone-700 border-stone-300 hover:bg-stone-50"
      >
        Loop
      </button>
      <button
        data-tag="point-to-point"
        class="tag-filter px-3 py-1 rounded-full text-sm border transition-colors bg-white text-stone-700 border-stone-300 hover:bg-stone-50"
      >
        Point-to-Point
      </button>
      <button
        data-tag="epic"
        class="tag-filter px-3 py-1 rounded-full text-sm border transition-colors bg-white text-stone-700 border-stone-300 hover:bg-stone-50"
      >
        Epic
      </button>
    </div>
  </div>

  {validRides.length === 0 ? (
    <p class="text-stone-500">No rides yet. Run <code class="bg-stone-200 px-2 py-1 rounded">npm run fetch-routes</code> to load route data.</p>
  ) : (
    <div id="rides-container" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {validRides.map(({ ride, routeData }) => (
        <div
          class="ride-card"
          data-name={routeData!.name.toLowerCase()}
          data-distance={routeData!.distance}
          data-elevation={routeData!.elevationGain}
          data-created={routeData!.createdAt}
          data-tags={ride.data.tags ? ride.data.tags.join(',') : ''}
        >
          <RideCard
            slug={ride.slug}
            routeData={routeData!}
            shortDescription={ride.data.short_description}
            tags={ride.data.tags}
          />
        </div>
      ))}
    </div>
  )}

  <div id="pagination-controls" class="mt-8 flex justify-center gap-2" style="display: none;">
    <!-- Pagination buttons will be generated by JavaScript -->
  </div>
</Layout>

<script>
  const RIDES_PER_PAGE = 16;
  let sortField = 'name';
  let sortOrder = 'asc';
  let currentPage = 1;
  let selectedTag = 'all';

  // Initialize from URL params
  function initFromURL() {
    const params = new URLSearchParams(window.location.search);
    const validSorts = ['name', 'date', 'distance', 'elevation'];
    const validOrders = ['asc', 'desc'];
    const validTags = ['all', 'loop', 'point-to-point', 'epic'];

    const sortParam = params.get('sort');
    const orderParam = params.get('order');
    const tagParam = params.get('tag');

    sortField = sortParam && validSorts.includes(sortParam) ? sortParam : 'name';
    sortOrder = orderParam && validOrders.includes(orderParam) ? orderParam : 'asc';
    currentPage = parseInt(params.get('page') || '1') || 1;
    selectedTag = tagParam && validTags.includes(tagParam) ? tagParam : 'all';

    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
    if (sortSelect) sortSelect.value = sortField;
    updateOrderButton();
    updateTagButtons();
  }

  // Update URL params without reload
  function updateURL() {
    const params = new URLSearchParams();
    params.set('sort', sortField);
    params.set('order', sortOrder);
    if (selectedTag !== 'all') {
      params.set('tag', selectedTag);
    }
    if (currentPage > 1) {
      params.set('page', currentPage.toString());
    }
    window.history.pushState({}, '', `${window.location.pathname}?${params.toString()}`);
  }

  // Update tag button styles
  function updateTagButtons() {
    document.querySelectorAll('.tag-filter').forEach(btn => {
      const tag = (btn as HTMLElement).dataset.tag;
      if (tag === selectedTag) {
        btn.className = 'tag-filter px-3 py-1 rounded-full text-sm border transition-colors bg-stone-800 text-white border-stone-800';
      } else {
        btn.className = 'tag-filter px-3 py-1 rounded-full text-sm border transition-colors bg-white text-stone-700 border-stone-300 hover:bg-stone-50';
      }
    });
  }

  // Sort and paginate the ride cards
  function sortAndPaginateRides() {
    const container = document.getElementById('rides-container');
    if (!container) return;

    const cards = Array.from(container.querySelectorAll('.ride-card')) as HTMLElement[];

    // Filter by tag first
    let filteredCards = cards;
    if (selectedTag !== 'all') {
      filteredCards = cards.filter(card => {
        const tags = card.dataset.tags || '';
        return tags.split(',').includes(selectedTag);
      });
    }

    // Sort cards
    filteredCards.sort((a, b) => {
      const dataAttr = sortField === 'date' ? 'created' : sortField;
      let aVal: string | number = a.dataset[dataAttr] || '';
      let bVal: string | number = b.dataset[dataAttr] || '';

      // Convert to numbers for numeric fields
      if (sortField !== 'name') {
        aVal = parseFloat(aVal as string) || 0;
        bVal = parseFloat(bVal as string) || 0;
      }

      let comparison;
      if (aVal < bVal) comparison = -1;
      else if (aVal > bVal) comparison = 1;
      else comparison = 0;

      return sortOrder === 'asc' ? comparison : -comparison;
    });

    // Re-append in sorted order and hide unfiltered cards
    filteredCards.forEach(card => container.appendChild(card));

    // Apply pagination (hide cards not on current page)
    const totalPages = Math.ceil(filteredCards.length / RIDES_PER_PAGE);
    const startIdx = (currentPage - 1) * RIDES_PER_PAGE;
    const endIdx = startIdx + RIDES_PER_PAGE;

    // Hide all cards first
    cards.forEach(card => {
      card.style.display = 'none';
    });

    // Show only filtered and paginated cards
    filteredCards.forEach((card, idx) => {
      if (idx >= startIdx && idx < endIdx) {
        card.style.display = '';
      }
    });

    // Update pagination controls
    updatePaginationControls(totalPages);
  }

  // Update pagination controls
  function updatePaginationControls(totalPages: number) {
    const container = document.getElementById('pagination-controls');
    if (!container) return;

    if (totalPages <= 1) {
      container.style.display = 'none';
      return;
    }

    container.style.display = 'flex';
    container.innerHTML = Array.from({ length: totalPages }, (_, i) => i + 1)
      .map(page => {
        const isActive = page === currentPage;
        return `
          <button
            class="px-4 py-2 rounded ${isActive ? 'bg-stone-800 text-white' : 'bg-stone-200 hover:bg-stone-300'}"
            data-page="${page}"
          >
            ${page}
          </button>
        `;
      })
      .join('');

    // Add event listeners to pagination buttons
    container.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const pageNum = (btn as HTMLElement).dataset.page;
        currentPage = parseInt(pageNum || '1');
        updateURL();
        sortAndPaginateRides();
      });
    });
  }

  // Update order button display
  function updateOrderButton() {
    const icon = document.getElementById('sort-order-icon');
    const text = document.getElementById('sort-order-text');
    if (icon) icon.textContent = sortOrder === 'asc' ? '↑' : '↓';
    if (text) text.textContent = sortOrder === 'asc' ? 'Ascending' : 'Descending';
  }

  // Event listeners
  const sortSelect = document.getElementById('sort-select');
  if (sortSelect) {
    sortSelect.addEventListener('change', (e) => {
      sortField = (e.target as HTMLSelectElement).value;
      currentPage = 1; // Reset to page 1 when sorting changes
      updateURL();
      sortAndPaginateRides();
    });
  }

  const sortOrderBtn = document.getElementById('sort-order-btn');
  if (sortOrderBtn) {
    sortOrderBtn.addEventListener('click', () => {
      sortOrder = sortOrder === 'asc' ? 'desc' : 'asc';
      currentPage = 1; // Reset to page 1 when order changes
      updateOrderButton();
      updateURL();
      sortAndPaginateRides();
    });
  }

  // Tag filter event listeners
  document.querySelectorAll('.tag-filter').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedTag = (btn as HTMLElement).dataset.tag || 'all';
      currentPage = 1; // Reset to page 1 when filter changes
      updateTagButtons();
      updateURL();
      sortAndPaginateRides();
    });
  });

  // Handle browser back/forward
  window.addEventListener('popstate', () => {
    initFromURL();
    sortAndPaginateRides();
  });

  // Initialize on page load
  initFromURL();
  sortAndPaginateRides();
</script>
