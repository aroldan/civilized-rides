---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import RideCard from '../components/RideCard.astro';
import { getRouteData } from '../lib/routes';

const RIDES_PER_PAGE = 8;

// Get all rides
const allRides = await getCollection('rides');

// Load route data for each ride
const ridesWithData = await Promise.all(
  allRides.map(async (ride) => {
    const routeData = await getRouteData(ride.slug);
    return { ride, routeData };
  })
);

// Filter out rides without route data
const validRides = ridesWithData.filter((r) => r.routeData !== null);

// For now, just show the first page (pagination can be added later)
const currentPage = 1;
const totalPages = Math.ceil(validRides.length / RIDES_PER_PAGE);
const paginatedRides = validRides.slice(0, RIDES_PER_PAGE);
---

<Layout title="Home">
  <!-- Hero Section -->
  <div class="relative w-full h-64 md:h-80 lg:h-96 mb-16 -mx-4 md:mx-0 rounded-none md:rounded-lg overflow-hidden">
    <img
      src="/img/hero.jpg"
      alt="A civilized group of road bike riders coming on Lincoln center on a beautiful sumemer morning"
      class="w-full h-full object-cover object-center"
      style="object-position: 50% 24%;"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 to-black/60 flex items-center justify-center">
      <div class="text-center text-white px-4">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4">Civilized Rides</h1>
        <p class="text-lg md:text-xl text-stone-200">Certified delightful bike routes in the Boston area</p>
      </div>
    </div>
  </div>

  <!-- About Section -->
  <div class="max-w-3xl mx-auto mb-12">
    <h2 class="text-2xl font-bold mb-4">What Makes a Ride Civilized?</h2>
    <div class="space-y-4 text-stone-700 leading-relaxed">
      <p>
        It's easy to get stuck in a rut as you start to ride bikes around the Boston area, sticking to the same
        boring bike path routes or out-and-back trafficky routes that you cook up on Google Maps.
      <p>
        Civilized Rides are here to help. These routes are hand-crafted to be beautiful with (mostly) good road
        and traffic conditions, as well as delightful stops for coffee, snacks, and other delights.
      </p>
      <p>I've personally scouted, ridden, and iterated on each of these and think you will like them.</p>
      <p>Anthony</p>
    </div>
  </div>

  {validRides.length === 0 ? (
    <p class="text-stone-500">No rides yet. Run <code class="bg-stone-200 px-2 py-1 rounded">npm run fetch-routes</code> to load route data.</p>
  ) : (
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {paginatedRides.map(({ ride, routeData }) => (
        <RideCard
          slug={ride.slug}
          routeData={routeData!}
          shortDescription={ride.data.short_description}
        />
      ))}
    </div>
  )}

  {totalPages > 1 && (
    <div class="mt-8 flex justify-center gap-2">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <a
          href={page === 1 ? '/' : `/page/${page}`}
          class={`px-4 py-2 rounded ${page === currentPage ? 'bg-stone-800 text-white' : 'bg-stone-200 hover:bg-stone-300'}`}
        >
          {page}
        </a>
      ))}
    </div>
  )}
</Layout>
